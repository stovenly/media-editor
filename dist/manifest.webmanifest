{
  "name": "Media Editor",
  "short_name": "Media Editor",
  "description": "Convert and edit images, audio and video. Files never leave your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f0f12",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".jfif",
          ".png",
          ".gif",
          ".webp",
          ".avif",
          ".heic",
          ".heif",
          ".jxl",
          ".bmp",
          ".svg",
          ".ico",
          ".cur",
          ".icns",
          ".tif",
          ".tiff",
          ".psd",
          ".exr",
          ".hdr",
          ".jp2",
          ".j2k",
          ".jpx",
          ".dds",
          ".tga",
          ".pcx",
          ".pnm",
          ".ppm",
          ".pgm",
          ".pbm",
          ".pam",
          ".xbm",
          ".xpm",
          ".sgi",
          ".ras",
          ".wbmp",
          ".qoi",
          ".fits",
          ".fit",
          ".dng",
          ".cr2",
          ".cr3",
          ".nef",
          ".arw",
          ".orf",
          ".rw2",
          ".raf",
          ".pef",
          ".srw"
        ],
        "audio/*": [
          ".mp3",
          ".aac",
          ".m4a",
          ".m4b",
          ".wav",
          ".flac",
          ".ogg",
          ".oga",
          ".opus",
          ".wma",
          ".aiff",
          ".aif",
          ".wv",
          ".ape",
          ".tta",
          ".tak",
          ".dsf",
          ".dff",
          ".rf64",
          ".w64",
          ".caf",
          ".ac3",
          ".dts",
          ".amr",
          ".spx",
          ".mpc",
          ".au",
          ".voc",
          ".ra",
          ".gsm"
        ],
        "video/*": [
          ".mp4",
          ".m4v",
          ".mov",
          ".mkv",
          ".webm",
          ".avi",
          ".wmv",
          ".mts",
          ".m2ts",
          ".ts",
          ".mpg",
          ".mpeg",
          ".mxf",
          ".dv",
          ".3gp",
          ".flv",
          ".rm",
          ".ogv",
          ".nut"
        ],
        "text/plain": [
          ".srt",
          ".vtt",
          ".ass",
          ".ssa"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "video/*",
            "text/plain",
            ".jpg",
            ".jpeg",
            ".jfif",
            ".png",
            ".gif",
            ".webp",
            ".avif",
            ".heic",
            ".heif",
            ".jxl",
            ".bmp",
            ".svg",
            ".ico",
            ".cur",
            ".icns",
            ".tif",
            ".tiff",
            ".psd",
            ".exr",
            ".hdr",
            ".jp2",
            ".j2k",
            ".jpx",
            ".dds",
            ".tga",
            ".pcx",
            ".pnm",
            ".ppm",
            ".pgm",
            ".pbm",
            ".pam",
            ".xbm",
            ".xpm",
            ".sgi",
            ".ras",
            ".wbmp",
            ".qoi",
            ".fits",
            ".fit",
            ".dng",
            ".cr2",
            ".cr3",
            ".nef",
            ".arw",
            ".orf",
            ".rw2",
            ".raf",
            ".pef",
            ".srw",
            ".mp3",
            ".aac",
            ".m4a",
            ".m4b",
            ".wav",
            ".flac",
            ".ogg",
            ".oga",
            ".opus",
            ".wma",
            ".aiff",
            ".aif",
            ".wv",
            ".ape",
            ".tta",
            ".tak",
            ".dsf",
            ".dff",
            ".rf64",
            ".w64",
            ".caf",
            ".ac3",
            ".dts",
            ".amr",
            ".spx",
            ".mpc",
            ".au",
            ".voc",
            ".ra",
            ".gsm",
            ".mp4",
            ".m4v",
            ".mov",
            ".mkv",
            ".webm",
            ".avi",
            ".wmv",
            ".mts",
            ".m2ts",
            ".ts",
            ".mpg",
            ".mpeg",
            ".mxf",
            ".dv",
            ".3gp",
            ".flv",
            ".rm",
            ".ogv",
            ".nut",
            ".srt",
            ".vtt",
            ".ass",
            ".ssa"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}